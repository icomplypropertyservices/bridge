# Server-only secrets (set in Vercel project env — never commit)
XRPL_TO_API_KEY=your_bridge_api_key
PLATFORM_FEE_BPS=85

# Client-side (bundled into the build — not a secret, but required)
# Create a project at https://dashboard.reown.com and add your deployed domain.
# AppKit: Ethereum/EVM + Solana
VITE_REOWN_PROJECT_ID=your_reown_project_id
# XRPL (Joey Wallet) client — optional, defaults to VITE_REOWN_PROJECT_ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
